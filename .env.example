# ==============================================================================
# MUNDER DIFFLIN — AUTONOMOUS AI BUSINESS OS CONFIGURATION
# ==============================================================================

# LLM Provider (Google AI Studio Gemini 2.5 Flash - Free Tier)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# System Operation Mode
# Set to 'true' to require manual review/approval before publishing to platforms
# Set to 'false' for autonomous scheduled publishing
SUPERVISED_MODE=true

# Emergency Stop (can also be toggled via 'py cli.py emergency-stop')
EMERGENCY_STOP=false

# Logging & Storage
LOG_LEVEL=INFO
DATA_DIR=data
DB_PATH=data/munder_difflin.db

# Platform OAuth Tokens & Client Secrets (To be configured in Phase 3 & 4)
# YOUTUBE_CLIENT_SECRETS_FILE=config/credentials/youtube_client_secrets.json
# INSTAGRAM_ACCESS_TOKEN=your_meta_page_token_here
# PINTEREST_ACCESS_TOKEN=your_pinterest_token_here
